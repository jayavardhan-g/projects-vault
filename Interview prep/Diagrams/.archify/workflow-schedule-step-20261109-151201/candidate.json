 "cards": [
  {
   "dot": "cyan",
   "title": "Order is policy",
   "items": [
    "Running first: a decode needs at most 1 block; a prefill can need hundreds",
    "Eviction before preemption: cached blocks hold no live work",
    "Victim = most recently admitted, so FCFS order survives"
   ]
  },
  {
   "dot": "emerald",
   "title": "Admission (waiting lane)",
   "items": [
    "needed = blocks past the cached prefix (_blocks_to_admit)",
    "Stop if free − needed < watermark: avoids admit-then-preempt thrash",
    "Hold back a request whose first uncached chunk another admit is already prefilling",
    "Never re-admit a request preempted in this same iteration"
   ]
  },
  {
   "dot": "rose",
   "title": "The bug story (README 879)",
   "items": [
    "Old code adopted the cached prefix, then could still fail the watermark",
    "Leaked refs + num_computed_tokens pointing at a table that lacked them",
    "Fix: mutate the request only after admission is certain"
   ]
  }
 ]
